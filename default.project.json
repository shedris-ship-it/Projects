{
  "name": "Consensus",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CharacterWalkSpeed": 8,
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 3,
        "CameraMaxZoomDistance": 14,
        "EnableMouseLockOption": false,
        "LoadCharacterAppearance": true
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": false,
        "FallenPartsDestroyHeight": -500
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "Ambient": [0.094, 0.102, 0.078],
        "OutdoorAmbient": [0.05, 0.05, 0.07],
        "Brightness": 0.4,
        "ClockTime": 0.5,
        "GlobalShadows": true,
        "ShadowSoftness": 0.6,
        "EnvironmentDiffuseScale": 0.15,
        "EnvironmentSpecularScale": 0.4,
        "ExposureCompensation": 0
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.32,
          "Offset": 0,
          "Color": [0.137, 0.149, 0.118],
          "Decay": [0.04, 0.04, 0.05],
          "Glare": 0,
          "Haze": 1.4
        }
      }
    },

    "MaterialService": {
      "$path": "assets/materials"
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },

    "TextChatService": {
      "$properties": {
        "CreateDefaultTextChannels": false,
        "CreateDefaultCommands": false
      },
      "ChatWindowConfiguration": {
        "$className": "ChatWindowConfiguration",
        "$properties": { "Enabled": false }
      },
      "ChatInputBarConfiguration": {
        "$className": "ChatInputBarConfiguration",
        "$properties": { "Enabled": false }
      }
    },

    "VoiceChatService": {
      "$properties": {
        "UseAudioApi": "Enabled"
      }
    }
  }
}
