-- The Guest's Blender model's rig (Data/GuestRig, generated by
-- tools/blender/guest.py; Stalker/GuestSkin, Lib/GuestMask): every bone
-- hangs where the game's rig can make it, rests at the joint it turns about,
-- and every piece is one the kit can load.

return function(test, check, Shared, require)
	local GuestRig = require(Shared.Data.GuestRig)
	local GuestPose = require(Shared.Logic.GuestPose)
	local KitData = require(Shared.Data.Kit)
	local Rig = GuestPose.Rig

	local PARTS = {
		HumanoidRootPart = true,
		LowerTorso = true,
		UpperTorso = true,
		Head = true,
		Mask = true,
	}
	for _, side in { "Left", "Right" } do
		for _, part in { "UpperArm", "LowerArm", "Hand", "UpperLeg", "LowerLeg", "Foot", "CoatTail" } do
			PARTS[side .. part] = true
		end
	end

	test("every bone hangs from a part of his rig or a bone made before it", function()
		local made = {}
		for _, bone in GuestRig.Bones do
			check.truthy(not made[bone.name], bone.name .. " is made once")
			if bone.part then
				check.truthy(PARTS[bone.part], bone.name .. " hangs from a part of his rig (" .. bone.part .. ")")
			else
				check.truthy(
					made[bone.bone],
					bone.name .. " hangs from a bone made before it (" .. tostring(bone.bone) .. ")"
				)
			end
			check.equal(#bone.at, 3, bone.name .. " has a place")
			made[bone.name] = bone
		end
		check.truthy(made.fMask and made.fMask.part == "Mask", "the face hangs from the mask")
	end)

	test("each joint's bone rests at the joint its Motor6D turns about", function()
		local by = {}
		for _, bone in GuestRig.Bones do
			by[bone.name] = bone.at
		end
		local function at(name, x, y, z)
			local p = by[name]
			check.truthy(p, name .. " is there")
			check.near(p[1], x, 1e-3, name .. " x")
			check.near(p[2], y, 1e-3, name .. " y")
			check.near(p[3], z, 1e-3, name .. " z")
		end
		at("gLowerTorso", 0, Rig.lowerTorsoY, 0)
		at("gUpperTorso", 0, Rig.waistY, 0)
		at("gHead", 0, Rig.neckY, 0)
		at("gLeftUpperArm", -Rig.shoulderX, Rig.shoulderY, 0)
		at("gRightLowerArm", Rig.shoulderX, Rig.shoulderY - Rig.upperArm, 0)
		at("gLeftHand", -Rig.shoulderX, Rig.shoulderY - Rig.upperArm - Rig.lowerArm, 0)
		at("gRightUpperLeg", Rig.hipX, Rig.hipY, 0)
		at("gLeftLowerLeg", -Rig.hipX, Rig.hipY - Rig.upperLeg, 0)
		at("gRightFoot", Rig.hipX, Rig.hipY - Rig.upperLeg - Rig.lowerLeg, 0)
		at("gLeftCoatTail", -Rig.hipX, Rig.hipY, 0)
	end)

	test("every piece rides on a part, has a look, and is in the kit", function()
		local looks = { GuestBody = true, GuestMask = true, GuestMaskWorn = true, GuestMaskBroken = true, Void = true }
		local bones = {}
		for _, bone in GuestRig.Bones do
			bones[bone.name] = true
		end
		local count = 0
		for name, piece in GuestRig.Pieces do
			count += 1
			check.truthy(PARTS[piece.part], name .. " rides on a part of his rig")
			check.truthy(looks[piece.look], name .. "'s look is one of his")
			check.truthy(KitData.Guest[name], name .. " is in Data/Kit's Guest group")
			if piece.shard then
				check.truthy(bones[piece.shard], name .. " comes away with a bone that's there")
			end
			if piece.overlay then
				check.equal(piece.look, name, name .. " is a shell with its own look")
			end
		end
		for name in KitData.Guest do
			check.truthy(GuestRig.Pieces[name], name .. " (Data/Kit) is a piece of him")
		end
		check.truthy(GuestRig.Pieces.GuestMask, "the mask is a piece")
		check.atLeast(count, 20, "his pieces")
	end)

	test("the face's grin has its columns and its poses move bones it has", function()
		local bones = {}
		for _, bone in GuestRig.Bones do
			bones[bone.name] = true
		end
		local face = GuestRig.Face
		check.atLeast(#face.columns, 9, "the grin's columns")
		for k, col in face.columns do
			check.truthy(bones[string.format("fU%02d", k)], "column " .. k .. "'s upper lip")
			check.truthy(bones[string.format("fL%02d", k)], "column " .. k .. "'s lower lip")
			local up = math.sqrt(col.up[1] ^ 2 + col.up[2] ^ 2 + col.up[3] ^ 2)
			check.near(up, 1, 1e-3, "column " .. k .. " parts along a direction")
			check.atLeast(col.up[2], 0, "column " .. k .. "'s up is up the face")
		end
		for _, pose in { "Smile", "BrowUp", "BrowDown", "Wide", "Droop", "JawOpen" } do
			check.truthy(face.poses[pose], pose .. " is posed")
			for bone in face.poses[pose] or {} do
				check.truthy(bones[bone], pose .. " moves " .. bone)
			end
		end
		check.truthy(face.eyes.L and face.eyes.R, "both eyes have pins")
	end)

	test("each hand has four fingers and a thumb, four bones down each", function()
		local bones = {}
		for _, bone in GuestRig.Bones do
			bones[bone.name] = true
		end
		for _, side in { "Left", "Right" } do
			local count = 0
			for _, finger in GuestRig.Fingers do
				if finger.hand == side then
					count += 1
					for _, suffix in { "1", "1e", "2", "3" } do
						check.truthy(bones[finger.bones .. suffix], finger.bones .. suffix)
					end
					check.atLeast(finger.first, 0.1, finger.bones .. "'s first segment")
					check.atLeast(finger.second, 0.1, finger.bones .. "'s second segment")
				end
			end
			check.equal(count, 5, side .. " hand's fingers")
		end
	end)
end
