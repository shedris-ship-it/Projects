-- The garage's party cars (Logic/Cars; LB2): seats, the wheel, the tape,
-- the dashboard, the honk and its countdown, friends only, a Roblox party's
-- car.
return function(test, check, Shared, require)
	local Cars = require(Shared.Logic.Cars)
	local cfg = {
		Seats = 4,
		Countdown = 5,
		Difficulty = { "Normal", "Hard" },
		Night = { "short", "full" },
		NightNames = { short = "short night", full = "full house" },
		Default = { difficulty = "Normal", night = "short" },
	}

	test("the first in takes the wheel, and the car fills seat by seat", function()
		local car = Cars.new(1, cfg)
		check.equal(Cars.board(car, 10), 1, "the wheel")
		check.equal(Cars.board(car, 20), 2, "beside")
		check.equal(Cars.board(car, 30), 3, "behind")
		check.equal(Cars.driver(car), 10, "the first in drives")
		check.equal(Cars.count(car), 3, "three in")
		check.truthy(Cars.canBoard(car, { userId = 40 }, 0), "a seat left")
		Cars.board(car, 40)
		local ok, why = Cars.canBoard(car, { userId = 50 }, 0)
		check.truthy(not ok and why == "full", "a full car: " .. tostring(why))
		local _, again = Cars.canBoard(car, { userId = 20 }, 0)
		check.equal(again, "seated", "already in it")
	end)

	test("when the driver gets out, the next passenger takes the wheel", function()
		local car = Cars.new(1, cfg)
		Cars.board(car, 10)
		Cars.board(car, 20)
		Cars.board(car, 30)
		local moves = Cars.leave(car, 10, cfg)
		check.equal(#moves, 1, "one move")
		check.equal(moves[1][1], 20, "the passenger beside")
		check.equal(moves[1][3], 1, "to the wheel")
		check.equal(Cars.driver(car), 20, "drives now")
		check.equal(#Cars.leave(car, 30, cfg), 0, "a passenger leaving moves nobody")
	end)

	test("only the driver works the dashboard and honks, and only with a tape", function()
		local car = Cars.new(1, cfg)
		Cars.board(car, 10)
		Cars.board(car, 20)
		check.truthy(not Cars.set(car, 20, "difficulty", "Hard", cfg), "a passenger can't")
		check.truthy(Cars.set(car, 10, "difficulty", "Hard", cfg), "the driver can")
		check.equal(car.difficulty, "Hard", "set")
		check.truthy(not Cars.set(car, 10, "night", "endless", cfg), "an unknown night")
		check.truthy(Cars.set(car, 10, "friendsOnly", true, cfg), "friends only")
		local ok, why = Cars.honk(car, 10, 0, cfg)
		check.truthy(not ok and why == "tape", "no tape, no leaving: " .. tostring(why))
		check.truthy(Cars.insertTape(car, "HalfwayHouse"), "the tape goes in")
		check.truthy(not Cars.insertTape(car, "StOdileWard"), "a second stays in your hand")
		check.truthy(not Cars.honk(car, 20, 0, cfg), "a passenger can't honk")
		check.truthy(Cars.honk(car, 10, 100, cfg), "the driver honks")
		check.equal(car.leavingAt, 105, "five seconds")
		check.truthy(not Cars.set(car, 10, "night", "full", cfg), "no changes while it's leaving")
		check.truthy(not Cars.due(car, 104), "not yet")
		check.truthy(Cars.due(car, 105), "off it goes")
	end)

	test("anyone can get out in the countdown; an empty car stops and resets", function()
		local car = Cars.new(1, cfg)
		Cars.board(car, 10)
		Cars.insertTape(car, "HalfwayHouse")
		Cars.set(car, 10, "difficulty", "Hard", cfg)
		Cars.honk(car, 10, 0, cfg)
		Cars.leave(car, 10, cfg)
		check.equal(car.leavingAt, nil, "the countdown stops")
		check.equal(car.tape, nil, "the tape goes back")
		check.equal(car.difficulty, "Normal", "the dashboard resets")
		check.truthy(not Cars.due(car, 10), "nobody leaves in an empty car")
	end)

	test("friends only lets in the driver's friends and party, not strangers", function()
		local car = Cars.new(1, cfg)
		Cars.board(car, 10)
		Cars.set(car, 10, "friendsOnly", true, cfg)
		local ok, why = Cars.canBoard(car, { userId = 99, friendOfDriver = false }, 0)
		check.truthy(not ok and why == "friends", "a stranger: " .. tostring(why))
		check.truthy(Cars.canBoard(car, { userId = 98, friendOfDriver = true }, 0), "a friend")
		-- (Friends only on an empty car means nothing: the next in drives it.)
		local empty = Cars.new(2, cfg)
		empty.friendsOnly = true
		check.truthy(Cars.canBoard(empty, { userId = 99 }, 0), "an empty car takes anyone")
	end)

	test("a Roblox party is held a car of its own for a while", function()
		local cars = { Cars.new(1, cfg), Cars.new(2, cfg) }
		Cars.board(cars[1], 5)
		check.equal(Cars.holdFor(cars, "party-a", 0, 90), 2, "the first empty car")
		check.equal(Cars.holdFor(cars, "party-a", 10, 90), 2, "the same car again")
		local ok, why = Cars.canBoard(cars[2], { userId = 7, partyId = "party-b" }, 10)
		check.truthy(not ok and why == "held", "another party waits: " .. tostring(why))
		check.truthy(Cars.canBoard(cars[2], { userId = 8, partyId = "party-a" }, 10), "the party gets in")
		check.truthy(Cars.canBoard(cars[2], { userId = 7, partyId = "party-b" }, 91), "after the hold, anyone")
		check.equal(Cars.holdFor(cars, "party-c", 20, 90), nil, "no empty car left to hold")
		check.equal(Cars.firstEmpty(cars, 20), nil, "none free while held")
		check.equal(Cars.firstEmpty(cars, 100), 2, "free once the hold ends")
	end)

	test("the sign tells strangers what the car is, from across the garage", function()
		local car = Cars.new(1, cfg)
		check.equal(Cars.sign(car, {}, nil, 0, cfg)[1], "NO TAPE YET", "an empty deck")
		Cars.board(car, 10)
		Cars.insertTape(car, "HalfwayHouse")
		local lines = Cars.sign(car, { [10] = "Ana" }, "The Halfway House", 0, cfg)
		check.equal(lines[1], "THE HALFWAY HOUSE", "the case")
		check.equal(lines[2], "NORMAL · SHORT NIGHT", "how")
		check.equal(lines[3], "3 SEATS LEFT", "seats")
		check.equal(lines[4], "Ana", "who's in")
		Cars.honk(car, 10, 0, cfg)
		check.equal(Cars.sign(car, {}, "x", 2.2, cfg)[3], "LEAVING IN 3", "the countdown")
	end)

	test("a car gone to the house takes nobody", function()
		local car = Cars.new(1, cfg)
		car.away = true
		local ok, why = Cars.canBoard(car, { userId = 1 }, 0)
		check.truthy(not ok and why == "away", "away")
	end)
end
