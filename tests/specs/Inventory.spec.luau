-- The two-slot inventory (Logic/Inventory): found tools in your right hand,
-- one at a time, or a free hand. The torch has its own hand and its own key
-- since 2026-10-12, so it is never in a slot.
return function(test, check, Shared, require)
	local Inventory = require(Shared.Logic.Inventory)

	local function tool(id: string, uid: string)
		return { id = id, uid = uid }
	end

	test("you start with a free hand and two empty slots", function()
		local inv = Inventory.new()
		check.equal(Inventory.SLOTS, 2, "two slots")
		check.equal(inv.active, Inventory.FREE, "a free hand")
		check.equal(Inventory.heldId(inv), nil, "holding nothing")
		check.equal(table.concat(Inventory.ids(inv), ","), ",", "slots")
	end)

	test("tools go into slots 1 then 2", function()
		local inv = Inventory.new()
		local ok, slot = Inventory.pickup(inv, tool("MusicBox", "a"))
		check.truthy(ok and slot == 1, "first tool in slot 1")
		ok, slot = Inventory.pickup(inv, tool("Radio", "b"))
		check.truthy(ok and slot == 2, "second tool in slot 2")
		check.equal(table.concat(Inventory.ids(inv), ","), "MusicBox,Radio", "slots")
	end)

	test("picking up doesn't change what's in your hand", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		check.equal(inv.active, Inventory.FREE, "still a free hand")
	end)

	test("select puts a slot in your hand, and its key again puts it away", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		check.truthy(Inventory.select(inv, 1), "changed")
		check.equal(Inventory.heldId(inv), "MusicBox", "holding the music box")
		check.equal(Inventory.toolId(inv), "MusicBox", "a tool")
		check.truthy(Inventory.select(inv, 1), "the same key again")
		check.equal(inv.active, Inventory.FREE, "put away")
		check.truthy(not Inventory.select(inv, 0), "already free")
		check.truthy(not Inventory.select(inv, 3), "no slot 3 any more")
		check.truthy(not Inventory.select(inv, -1), "no slot -1")
		check.truthy(not Inventory.select(inv, 1.5), "no half slots")
	end)

	test("the wheel's exact choice never puts away what it chose", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("Radio", "a"))
		Inventory.select(inv, 1, true)
		check.truthy(not Inventory.select(inv, 1, true), "already there: no change")
		check.equal(Inventory.heldId(inv), "Radio", "still in hand")
	end)

	test("0 puts away what's in your hand", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("Radio", "a"))
		Inventory.select(inv, 1)
		check.truthy(Inventory.select(inv, 0), "changed")
		check.equal(Inventory.heldId(inv), nil, "nothing in hand")
	end)

	test("an empty slot leaves the hand free", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("Radio", "a"))
		Inventory.select(inv, 1)
		check.truthy(Inventory.select(inv, 2), "chose the empty slot")
		check.equal(inv.active, Inventory.FREE, "a free hand, not an empty slot")
		check.truthy(not Inventory.select(inv, 2), "and again changes nothing")
	end)

	test("the wheel goes round a free hand and the slots with something in them", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("Lantern", "a"))
		check.truthy(Inventory.cycle(inv, 1), "moved on")
		check.equal(inv.active, 1, "to the lantern")
		Inventory.cycle(inv, 1)
		check.equal(inv.active, Inventory.FREE, "past the empty slot to a free hand")
		Inventory.cycle(inv, -1)
		check.equal(inv.active, 1, "and back")
		Inventory.pickup(inv, tool("Radio", "b"))
		Inventory.cycle(inv, 1)
		check.equal(inv.active, 2, "on to the radio")
		local alone = Inventory.new()
		check.truthy(not Inventory.cycle(alone, 1), "with nothing to hold, nowhere to go")
		check.equal(alone.active, Inventory.FREE, "still a free hand")
	end)

	test("with both slots full, a pickup swaps with the tool in your hand", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		Inventory.pickup(inv, tool("Radio", "b"))
		Inventory.select(inv, 2)
		local ok, slot, old = Inventory.pickup(inv, tool("Lantern", "c"))
		check.truthy(ok and slot == 2, "went into the slot in your hand")
		check.equal(old and old.id, "Radio", "the radio is put down")
		check.equal(table.concat(Inventory.ids(inv), ","), "MusicBox,Lantern", "slots")
	end)

	test("with both full and a free hand, a pickup is refused", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		Inventory.pickup(inv, tool("Radio", "b"))
		local ok = Inventory.pickup(inv, tool("Lantern", "c"))
		check.truthy(not ok, "no free slot")
		check.equal(table.concat(Inventory.ids(inv), ","), "MusicBox,Radio", "nothing changed")
	end)

	test("dropping empties the slot and frees your hand if it was in it", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		Inventory.select(inv, 1)
		local item = Inventory.drop(inv, 1)
		check.equal(item and item.uid, "a", "got the music box back")
		check.equal(inv.active, Inventory.FREE, "a free hand again")
		check.equal(table.concat(Inventory.ids(inv), ","), ",", "slots")
	end)

	test("an empty slot or no slot gives nothing", function()
		local inv = Inventory.new()
		check.equal(Inventory.drop(inv, 1), nil, "empty slot")
		check.equal(Inventory.drop(inv, 0), nil, "a free hand isn't a slot")
		check.equal(Inventory.drop(inv, 7), nil, "no such slot")
	end)

	test("dropAll gives up every tool", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		Inventory.pickup(inv, tool("Lantern", "b"))
		Inventory.select(inv, 2)
		local items = Inventory.dropAll(inv)
		check.equal(#items, 2, "both tools")
		check.equal(table.concat(Inventory.ids(inv), ","), ",", "nothing left")
		check.equal(inv.active, Inventory.FREE, "a free hand")
	end)
end
