-- The three-slot inventory (Logic/Inventory): slot 1 is the torch, 2 and 3
-- hold found tools; one thing in your hands at a time, and anything but the
-- torch clips it to your shirt. An empty slot is a free hand. (Slot 4, bare
-- hands, went with the squad playtest of 2026-10-08: your hands work from
-- any slot now.)
return function(test, check, Shared, require)
	local Inventory = require(Shared.Logic.Inventory)

	local function tool(id: string, uid: string)
		return { id = id, uid = uid }
	end

	test("you start with the torch in your hands and nothing else", function()
		local inv = Inventory.new()
		check.equal(Inventory.SLOTS, 3, "three slots")
		check.equal(Inventory.heldId(inv), "Flashlight", "holding the torch")
		check.truthy(Inventory.torchHeld(inv), "torch held")
		check.truthy(not Inventory.torchClipped(inv), "not clipped")
		check.equal(table.concat(Inventory.ids(inv), ","), "Flashlight,,", "slots")
	end)

	test("tools go into slots 2 then 3", function()
		local inv = Inventory.new()
		local ok, slot = Inventory.pickup(inv, tool("MusicBox", "a"))
		check.truthy(ok and slot == 2, "first tool in slot 2")
		ok, slot = Inventory.pickup(inv, tool("Radio", "b"))
		check.truthy(ok and slot == 3, "second tool in slot 3")
		check.equal(table.concat(Inventory.ids(inv), ","), "Flashlight,MusicBox,Radio", "slots")
	end)

	test("picking up doesn't change what's in your hands", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		check.truthy(Inventory.torchHeld(inv), "still holding the torch")
	end)

	test("select puts a slot in your hands, and only slots 1 to 3", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		check.truthy(Inventory.select(inv, 2), "changed")
		check.equal(Inventory.heldId(inv), "MusicBox", "holding the music box")
		check.equal(Inventory.toolId(inv), "MusicBox", "a tool")
		check.truthy(not Inventory.torchHeld(inv), "torch put away")
		check.truthy(Inventory.torchClipped(inv), "torch clipped to your shirt")
		check.truthy(not Inventory.select(inv, 2), "already there")
		check.truthy(not Inventory.select(inv, 0), "no slot 0")
		check.truthy(not Inventory.select(inv, 4), "no slot 4 any more")
		check.truthy(not Inventory.select(inv, 1.5), "no half slots")
	end)

	test("an empty slot can be selected: a free hand, the torch on your shirt", function()
		local inv = Inventory.new()
		check.truthy(Inventory.select(inv, 3), "chose the empty slot")
		check.equal(Inventory.heldId(inv), nil, "nothing")
		check.equal(Inventory.toolId(inv), nil, "not a tool")
		check.truthy(Inventory.torchClipped(inv), "torch clipped")
	end)

	test("the wheel goes round all three, empty slots too", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("Lantern", "a"))
		check.truthy(Inventory.cycle(inv, 1), "moved on")
		check.equal(inv.active, 2, "to the lantern")
		Inventory.cycle(inv, 1)
		check.equal(inv.active, 3, "to the empty slot: a free hand")
		Inventory.cycle(inv, 1)
		check.equal(inv.active, 1, "wrapped round to the torch")
		Inventory.cycle(inv, -1)
		check.equal(inv.active, 3, "and back")
		local alone = Inventory.new()
		check.truthy(Inventory.cycle(alone, 1), "with only the torch there is still somewhere to go")
	end)

	test("with both tool slots full, a pickup swaps with the tool in your hands", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		Inventory.pickup(inv, tool("Radio", "b"))
		Inventory.select(inv, 3)
		local ok, slot, old = Inventory.pickup(inv, tool("Lantern", "c"))
		check.truthy(ok and slot == 3, "went into the slot in your hands")
		check.equal(old and old.id, "Radio", "the radio is put down")
		check.equal(table.concat(Inventory.ids(inv), ","), "Flashlight,MusicBox,Lantern", "slots")
	end)

	test("with both full and the torch in your hands, a pickup is refused", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		Inventory.pickup(inv, tool("Radio", "b"))
		local ok = Inventory.pickup(inv, tool("Lantern", "c"))
		check.truthy(not ok, "no free tool slot")
		check.equal(table.concat(Inventory.ids(inv), ","), "Flashlight,MusicBox,Radio", "nothing changed")
	end)

	test("dropping empties the slot and sends you back to the torch if it was in your hands", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		Inventory.select(inv, 2)
		local item = Inventory.drop(inv, 2)
		check.equal(item and item.uid, "a", "got the music box back")
		check.equal(inv.active, 1, "holding the torch again")
		check.equal(table.concat(Inventory.ids(inv), ","), "Flashlight,,", "slots")
	end)

	test("the torch can't be dropped, and an empty slot gives nothing", function()
		local inv = Inventory.new()
		check.equal(Inventory.drop(inv, 1), nil, "torch stays")
		check.equal(Inventory.drop(inv, 2), nil, "empty slot")
		check.equal(Inventory.drop(inv, 7), nil, "no such slot")
		check.equal(Inventory.heldId(inv), "Flashlight", "still holding it")
	end)

	test("dropAll gives up every tool and leaves the torch", function()
		local inv = Inventory.new()
		Inventory.pickup(inv, tool("MusicBox", "a"))
		Inventory.pickup(inv, tool("Lantern", "b"))
		Inventory.select(inv, 3)
		local items = Inventory.dropAll(inv)
		check.equal(#items, 2, "both tools")
		check.equal(table.concat(Inventory.ids(inv), ","), "Flashlight,,", "only the torch left")
		check.equal(inv.active, 1, "torch in hand")
	end)
end
