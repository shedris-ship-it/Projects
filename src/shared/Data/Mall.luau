			shape = "Ball",
			color = DEAD_GLASS,
			material = "Glass",
			collide = false,
		})
	end
end

-- The diner's booths: a table and a bench seat either side facing it,
-- `along` the way its seats line up ("z": down the court wall; "x": out
-- from an end wall).
local function booth(x: number, z: number, along: string)
	local turn = along == "x" and 90 or 0
	table.insert(Mall.Blocks, {
		room = "diner",
		name = "BoothTable",
		kit = "DinerTable",
		x = x,
		y = 1.3,
		z = z,
		size = { 4.4, 2.6, 2.9 },
		rot = { 0, turn, 0 },
		color = { 220, 220, 214 },
	})
	for _, side in { -1, 1 } do
		local face = if along == "x" then (side < 0 and 90 or -90) else (side < 0 and 0 or 180)
		table.insert(Mall.Blocks, {
			room = "diner",
			name = "BoothSeat",
			kit = "DinerBoothSeat",
			x = x + (along == "x" and side * 2.3 or 0),
			y = 2.1,
			z = z + (along == "z" and side * 2.3 or 0),
			size = { 5, 4.2, 1.7 },
			rot = { 0, face, 0 },
			color = { 170, 30, 36 },
		})
	end
end
